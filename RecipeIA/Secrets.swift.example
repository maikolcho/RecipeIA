// Copia este archivo como "Secrets.swift" y rellena tus claves.
// Nutritionix: https://developer.nutritionix.com  ·  Gemini: https://aistudio.google.com/apikey
// Secrets.swift está en .gitignore y no se sube a GitHub.
enum Secrets {
    static let nutritionixAppId = "TU_APP_ID"
    static let nutritionixApiKey = "TU_API_KEY"
    // Clave de Gemini (https://aistudio.google.com/apikey). Si está vacía, la app usa Nutritionix.
    static let geminiApiKey = "TU_CLAVE_DE_GEMINI"
    // Modelo de Gemini; cámbialo si Google lo renombra (https://ai.google.dev/gemini-api/docs/models).
    static let geminiModel = "gemini-3.8-flash"
}
